{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/work-with-me/content-and-social",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/work-with-me/content-and-social",
      "permanent": true
    },
    {
      "source": "/ugc-brands",
      "destination": "/work-with-me/ugc",
      "permanent": true
    },
    {
      "source": "/ugc-brands.html",
      "destination": "/work-with-me/ugc",
      "permanent": true
    },
    {
      "source": "/recommendations.html",
      "destination": "/recommendations/shop",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.edenrusak.com"
        }
      ],
      "destination": "https://edenrusak.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rec-admin.html",
      "destination": "https://academy.edenrusak.com/admin/site/products",
      "permanent": false
    },
    {
      "source": "/rec-admin",
      "destination": "https://academy.edenrusak.com/admin/site/products",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "destination": "https://academy.edenrusak.com/admin/site",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://academy.edenrusak.com/admin/site",
      "permanent": false
    },
    {
      "source": "/site-admin.html",
      "destination": "https://academy.edenrusak.com/admin/site",
      "permanent": false
    },
    {
      "source": "/landing.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "editit"
        }
      ],
      "destination": "/editit",
      "permanent": true
    },
    {
      "source": "/landing",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "editit"
        }
      ],
      "destination": "/editit",
      "permanent": true
    },
    {
      "source": "/site-admin",
      "destination": "https://academy.edenrusak.com/admin/site",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(images|videos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(landing|product|shop-product|admin|rec-admin).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/proposals/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/google-tag-gateway/",
      "destination": "/api/google-tag-gateway?gateway_path="
    },
    {
      "source": "/google-tag-gateway",
      "destination": "/api/google-tag-gateway?gateway_path="
    },
    {
      "source": "/google-tag-gateway/:path*",
      "destination": "/api/google-tag-gateway?gateway_path=:path*"
    },
    {
      "source": "/recommendations/travel/:slug((?!destination$)[^/]+)",
      "destination": "/recommendations/travel/destination"
    }
  ],
  "functions": {
    "api/agreement.js": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "{proposals/**/index.html,node_modules/@sparticuz/chromium/bin/**}"
    }
  }
}
