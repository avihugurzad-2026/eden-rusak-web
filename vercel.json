{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.edenrusak.com"
        }
      ],
      "destination": "https://edenrusak.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rec-admin.html",
      "destination": "https://academy.edenrusak.com/admin/site/products",
      "permanent": false
    },
    {
      "source": "/rec-admin",
      "destination": "https://academy.edenrusak.com/admin/site/products",
      "permanent": false
    },
    {
      "source": "/site-admin.html",
      "destination": "https://academy.edenrusak.com/admin/site/catalog",
      "permanent": false
    },
    {
      "source": "/site-admin",
      "destination": "https://academy.edenrusak.com/admin/site/catalog",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(images|videos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(landing|product|shop-product|admin|rec-admin).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/google-tag-gateway/",
      "destination": "/api/google-tag-gateway?gateway_path="
    },
    {
      "source": "/google-tag-gateway",
      "destination": "/api/google-tag-gateway?gateway_path="
    },
    {
      "source": "/google-tag-gateway/:path*",
      "destination": "/api/google-tag-gateway?gateway_path=:path*"
    }
  ]
}
